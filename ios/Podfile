# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command(
  'node',
  ['-p',
   'require.resolve(
     "react-native/scripts/react_native_pods.rb",
     { paths: [process.argv[1]] }
   )', __dir__]
).strip

# 🚨 FORCE iOS VERSION (CRITICAL)
platform :ios, '15.1'

# Disable New Architecture
ENV['RCT_NEW_ARCH_ENABLED'] = '0'

prepare_react_native_project!

# 🚨 Firebase + RN REQUIRE STATIC FRAMEWORKS
use_frameworks! :linkage => :static
$RNFirebaseAsStaticFramework = true

target 'Pryvo' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :fabric_enabled => false
  )

  target 'PryvoTests' do
    inherit! :complete
  end

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )

    # Fix Xcode 15+/iOS issues
    installer.pods_project.targets.each do |target|
      if target.respond_to?(:build_configurations)
        target.build_configurations.each do |config|
          config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'

          # Remove RCT_NEW_ARCH_ENABLED from preprocessor definitions entirely
          # Using #ifdef means even =0 is treated as "defined"
          if config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
            defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS']
            defs = [defs] if defs.is_a?(String)
            defs = defs.reject { |d| d.to_s.include?('RCT_NEW_ARCH_ENABLED') }
            config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
          end

          # Also remove from OTHER_CFLAGS and OTHER_CPLUSPLUSFLAGS
          ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS'].each do |flag_key|
            if config.build_settings[flag_key]
              val = config.build_settings[flag_key]
              if val.is_a?(String)
                config.build_settings[flag_key] = val.gsub(/-DRCT_NEW_ARCH_ENABLED\S*/, '').strip
              elsif val.is_a?(Array)
                config.build_settings[flag_key] = val.reject { |v| v.to_s.include?('RCT_NEW_ARCH_ENABLED') }
              end
            end
          end
        end
      end
    end
    installer.pods_project.save
  end
end
